:80 {
	root * /srv/trilema

	header Cache-Control "public, max-age=86400, immutable"

	# Main page I browse while working on the archive, remove redirect if not wanted
	redir / /archives-categories/ temporary

	# Don't serve extraneous files
	@rejects path /.git /.github /utils /_headers /_ignores /_redirects /Caddyfile /compose.yml /README.md
	respond @rejects 404

	@logs path /forum-logs-*
	try_files @logs /2019{path} /2019{path}/ /2020{path} /2020{path}/

	try_files {path} {path}/
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
